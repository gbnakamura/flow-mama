# Public Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credential. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FLOW_MAMA_PRODUCT_ID=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=Flow Mama <bookings@flowmamanorthfields.com>
